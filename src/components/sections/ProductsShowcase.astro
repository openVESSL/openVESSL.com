---
import { getCollection } from 'astro:content';
import ProductCard from '@/components/sections/ProductCard.astro';

const products = await getCollection('products');
---

<section id="products" class="border-t border-border">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
    <div class="max-w-xl">
      <span class="inline-flex items-center rounded-sm border border-border bg-secondary px-3 py-1 font-mono text-xs uppercase tracking-wider text-muted-foreground">
        Cargo manifest
      </span>
      <h2 class="mt-4 font-heading text-3xl font-semibold tracking-tight sm:text-4xl">
        What's actually shipped
      </h2>
      <p class="mt-4 text-muted-foreground">
        One product so far. It's real, it's in use, and the repo has the receipts.
      </p>
    </div>

    <div class="mt-10 flex flex-wrap gap-6">
      {products.map((product) => (
        <div class="w-full max-w-md">
          <ProductCard product={product} />
        </div>
      ))}
    </div>
  </div>
</section>
