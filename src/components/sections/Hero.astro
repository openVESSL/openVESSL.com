---
import { ArrowDown } from 'lucide-react';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
---

<section class="relative overflow-hidden">
  <div class="mx-auto max-w-6xl px-4 pb-16 pt-10 sm:px-6 sm:pb-24 sm:pt-14">
    <div class="console-panel relative rounded-md border border-border bg-card/40 p-6 sm:p-12">
      <span class="corner corner-tl" aria-hidden="true"></span>
      <span class="corner corner-tr" aria-hidden="true"></span>
      <span class="corner corner-bl" aria-hidden="true"></span>
      <span class="corner corner-br" aria-hidden="true"></span>

      <div class="flex flex-col items-start gap-6">
        <h1 class="max-w-3xl text-balance font-heading text-4xl font-semibold tracking-tight sm:text-5xl md:text-6xl">
          A vessel needs more than one part.{' '}
          <span class="text-muted-foreground">So does ours.</span>
        </h1>

        <p class="max-w-xl text-pretty text-lg text-muted-foreground sm:text-xl">
          openVESSL is a small GitHub org building self-hosted and open-source tools
          to enhance everyday workflows and setups.
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a href="#products" class={cn(buttonVariants({ size: 'lg' }), 'h-11 px-6 font-mono text-xs uppercase tracking-wider')}>
            See what's shipped
          </a>
          <a
            href="https://github.com/openVESSL"
            target="_blank"
            rel="noreferrer"
            class={cn(buttonVariants({ size: 'lg', variant: 'outline' }), 'h-11 px-6 font-mono text-xs uppercase tracking-wider')}
          >
            Explore the org on GitHub
          </a>
        </div>
      </div>

      <div class="mt-12 flex flex-wrap items-center justify-between gap-3 border-t border-border pt-4 font-mono text-[11px] uppercase tracking-widest text-muted-foreground">
        <span>openVESSL // built in the open</span>
        <a href="#mission" class="inline-flex items-center gap-1.5 transition-colors hover:text-foreground">
          <ArrowDown className="size-3" aria-hidden="true" />
          why the metaphor
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .console-panel {
    background-color: color-mix(in oklab, var(--card) 55%, transparent);
  }

  .corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--primary);
    opacity: 0.85;
  }
  .corner-tl { top: -1px; left: -1px; border-top: 2px solid; border-left: 2px solid; }
  .corner-tr { top: -1px; right: -1px; border-top: 2px solid; border-right: 2px solid; }
  .corner-bl { bottom: -1px; left: -1px; border-bottom: 2px solid; border-left: 2px solid; }
  .corner-br { bottom: -1px; right: -1px; border-bottom: 2px solid; border-right: 2px solid; }
</style>
